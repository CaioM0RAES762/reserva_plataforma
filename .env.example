# Banco de dados (SQL Server)
DB_HOST=localhost
DB_PORT=1433
DB_NAME=PlataformaRes
DB_USER=sa
DB_PASSWORD=changeme
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Redis (rate limit, BullMQ)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=changeme-dev-only
JWT_EXPIRES_IN=8h

# Seed do primeiro Admin (nunca hardcode em codigo)
SEED_ADMIN_EMAIL=caio.moraes@metalsider.com.br
SEED_ADMIN_PASSWORD=changeme

# ── Envio de e-mail (códigos de ativação e de recuperação de senha) ──────────────────
# EMAIL_PROVIDER escolhe o provedor explicitamente ("smtp" ou "graph") e faz o boot da API
# falhar alto e claro se a config daquele provedor estiver incompleta — em vez de subir
# "funcionando" e só quebrar quando um usuário tentar ativar a conta. Sem EMAIL_PROVIDER
# definido, o provedor é autodetectado pelas credenciais presentes (SMTP tem precedência
# sobre Graph); sem nenhuma credencial:
#   - em desenvolvimento, o e-mail é gravado em apps/api/emails-dev/*.html (nada é
#     enviado de verdade, mas o fluxo continua testável);
#   - em produção, a API responde 502 e a tela avisa que o código não pôde ser enviado
#     (nunca finge sucesso sem ter enviado nada).
#
# Diagnóstico (não substitui testar o fluxo real pela aplicação — ver README):
# pnpm --filter @plataformares/api email:diagnose alguem@metalsider.com.br
EMAIL_PROVIDER=smtp

# Opção 1 — SMTP. Com Gmail, EMAIL_PASSWORD (ou SMTP_PASS) é uma SENHA DE APP
# (myaccount.google.com → Segurança → Senhas de app), nunca a senha da conta; exige
# verificação em duas etapas ativa. Porta 587 ⇒ EMAIL_SECURE=false (STARTTLS);
# porta 465 ⇒ EMAIL_SECURE=true. SMTP_HOST/PORT/USER/PASS são aceitos como alias e têm
# precedência sobre EMAIL_HOST/PORT/USER/PASSWORD, se ambos estiverem definidos.
#
# ATENÇÃO — deliverability contra caixas corporativas Microsoft 365/Exchange Online: um
# remetente Gmail externo com nome de exibição igual ao da organização (ex.: "Metalsider
# <...@gmail.com>") é o padrão clássico de impersonação de marca que o Defender/EOP
# quarentena por padrão — SMTP pode responder 250 OK e a mensagem nunca aparecer, nem no
# spam. EMAIL_FROM_NAME abaixo é propositalmente "PlataformaRes" (o produto), não
# "Metalsider" (a organização), para reduzir esse risco. A correção definitiva é usar a
# Opção 2 (Microsoft Graph) com uma caixa real do tenant metalsider.com.br — só assim
# SPF/DKIM/DMARC ficam alinhados ao domínio de quem recebe.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=PlataformaRes
EMAIL_FROM=

# Opção 2 — Microsoft Graph (resolve a deliverability acima por completo). O app
# registrado no Entra ID precisa da permissão de APLICAÇÃO Mail.Send (com consentimento do
# administrador do tenant). GRAPH_SENDER é a caixa remetente, que precisa ser real e
# licenciada no tenant metalsider.com.br (GRAPH_SENDER_EMAIL é aceito como alias).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=

# Azure Blob Storage (anexos/fotos de checklist, S11). Em produção, aponte para a conta
# real do Azure; em dev, use o Azurite (emulador local, npx azurite-blob) com a connection
# string padrão documentada pela Microsoft:
# DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=anexos-reserva

API_PORT=3335
WEB_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3335
